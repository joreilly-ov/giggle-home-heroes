# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
bun.lock
bun.lockb

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor - Android
/android/local.properties
/android/app/build
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
/android/capacitor-cordova-android-plugins

# Capacitor - iOS (generated by `cap sync`, do not commit)
/ios/App/App/public
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml

# Xcode - user-specific state (not portable between machines)
xcuserdata/
*.xcuserstate
*.xcschememanagement.plist

# Xcode - build output
/ios/App/build/
/ios/App/DerivedData/
*.hmap

# CocoaPods - install with `pod install` (do not commit the Pods/ directory)
/ios/App/Pods/

# Xcode environment overrides
/ios/App/.xcode.env.local
